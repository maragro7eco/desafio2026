: 418\nColumns: 4\n$ img &lt;chr&gt; \"100_Grãos - contagem_1_2023-12-22-08-06-58\", \"101_Grãos - contage…\n$ NG  &lt;int&gt; 231, 288, 328, 246, 699, 762, 704, 422, 352, 1572, 496, 220, 281, …\n$ CG  &lt;dbl&gt; 0.3894683, 0.3597025, 0.3635707, 0.3629542, 0.3662044, 0.3632955, …\n$ LG  &lt;dbl&gt; 0.2023824, 0.1768752, 0.1777208, 0.1827836, 0.1822657, 0.1808560, …\n\n# Calculo número total de cápsulas (NC)** para cada planta.\ncapsulas_nc &lt;- \n  capsulas %&gt;%\n  group_by(img) %&gt;%\n  summarise(\n    NC = n(),\n    .groups = \"drop\"\n  )\n\n# Visualizar o resultado\nhead(capsulas_nc)\n\n# A tibble: 6 × 2\n  img                                   NC\n  &lt;chr&gt;                              &lt;int&gt;\n1 100_Cápsulas_1_2023-12-22-07-58-19    32\n2 101_Cápsulas_1_2024-02-22-03-06-13    43\n3 102_Cápsulas_1_2024-02-22-03-09-17    54\n4 103_Cápsulas_1_2024-02-22-03-10-41    37\n5 104_Cápsulas_1_2024-02-22-03-12-01    52\n6 105_Cápsulas_1_2024-02-22-03-14-13    90\n\n# Verificar a estrutura do novo data frame\nglimpse(capsulas_nc)\n\nRows: 409\nColumns: 2\n$ img &lt;chr&gt; \"100_Cápsulas_1_2023-12-22-07-58-19\", \"101_Cápsulas_1_2024-02-22-0…\n$ NC  &lt;int&gt; 32, 43, 54, 37, 52, 90, 91, 103, 92, 58, 55, 237, 76, 37, 36, 90, …\n\n# Extração do ID\ngraos_resumo &lt;- graos_resumo %&gt;%\n  mutate(\n    ID = str_extract(as.character(img), \"^\\\\d+\"), \n    unique(graos_resumo$img)\n  )\n\ncapsulas_nc &lt;- capsulas_nc %&gt;%\n  mutate(\n    ID = str_extract(as.character(img), \"^\\\\d+\"),\n     unique(capsulas_nc$img)\n  )"
